{"id": "rag-106", "input": {"messages": [{"role": "user", "content": "I'm in Dublin and ordered with standard delivery on a Monday. If I don't like it, what's the latest I can return it?"}]}, "reference": "Ireland is supported; standard delivery takes 3-5 working days, and the 30-day return window starts from the day the item is received, so the deadline is 30 days after delivery.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "rag_multi_document", "risk": "medium", "source": "synthetic"}}
{"id": "rag-107", "input": {"messages": [{"role": "user", "content": "Can I get express delivery to Germany, and how would I return it if it doesn't suit?"}]}, "reference": "Yes: express is next working day if ordered before 2pm. Returns: within 30 days with a receipt, via Account > Orders > Return an item, print the label, drop at a post office.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "rag_multi_document", "risk": "medium", "source": "synthetic"}}
{"id": "rag-108", "input": {"messages": [{"role": "user", "content": "My mug arrived chipped yesterday. What should I do, and can it go in the dishwasher once it's replaced?"}]}, "reference": "Contact us via the Contact us form within 30 days with a photo for a full refund. Stoneware is dishwasher safe.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "rag_multi_document", "risk": "medium", "source": "synthetic"}}
{"id": "rag-109", "input": {"messages": [{"role": "user", "content": "Can I put the stoneware mugs in the microwave?"}]}, "reference": "Yes, unless they have a metallic glaze (marked 'metallic' on the product page), which is not microwave safe.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "rag_product_info", "risk": "low", "source": "synthetic"}}
{"id": "rag-110", "input": {"messages": [{"role": "user", "content": "How should I clean a wool rug?"}]}, "reference": "Vacuum without the beater bar, blot spills and spot clean with cold water. No steam cleaning or machine washing.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "rag_product_info", "risk": "low", "source": "synthetic"}}
