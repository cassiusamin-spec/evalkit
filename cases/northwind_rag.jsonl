{"id": "refund-101", "input": {"messages": [{"role": "user", "content": "Hi, what's your returns policy?"}]}, "reference": "Refunds within 30 days with a receipt; after 30 days, store credit only.", "graders": [{"type": "regex", "pattern": "\\b(30|thirty)[- ]?days?\\b", "failure_type": "wrong_policy"}, {"type": "not_contains", "values": ["60 days", "60-day", "90 days", "90-day", "365"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "refunds", "risk": "high", "source": "synthetic"}}
{"id": "refund-102", "input": {"messages": [{"role": "user", "content": "I bought a rug 3 weeks ago and I don't like it. Can I send it back?"}]}, "reference": "Yes. It's within the 30-day window, so with a receipt they can get a refund.", "graders": [{"type": "not_contains", "values": ["60 days", "60-day", "90 days", "90-day", "365"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "refunds", "risk": "high", "source": "synthetic"}}
{"id": "refund-103", "input": {"messages": [{"role": "user", "content": "It's been 31 days since I bought my lamp. Can I still get my money back?"}]}, "reference": "No refund: it's just outside the 30-day window. Offer store credit instead.", "graders": [{"type": "regex", "pattern": "store credit", "failure_type": "wrong_policy"}, {"type": "not_contains", "values": ["60 days", "60-day", "90 days", "90-day", "365"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "refunds", "risk": "high", "source": "synthetic"}}
{"id": "refund-104", "input": {"messages": [{"role": "user", "content": "I've lost my receipt. Can I still return something I bought last week?"}]}, "reference": "Refunds need a receipt. Does not promise a refund without one; may suggest checking for the order confirmation email or contacting the team.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "refunds", "risk": "medium", "source": "synthetic"}}
{"id": "refund-105", "input": {"messages": [{"role": "user", "content": "Someone bought me a vase as a present about two months ago. Can I get a refund?"}]}, "reference": "Outside the 30-day window, so no refund; store credit is the option.", "graders": [{"type": "not_contains", "values": ["60 days", "60-day", "90 days", "90-day", "365"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "refunds", "risk": "high", "source": "synthetic"}}
{"id": "refund-106", "input": {"messages": [{"role": "user", "content": "Do you do exchanges?"}]}, "reference": "The policy doesn't mention exchanges. Must not invent an exchange policy; can explain the 30-day refund and store-credit rules or suggest contacting the team.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "policy_gaps", "risk": "medium", "source": "synthetic"}}
{"id": "refund-107", "input": {"messages": [{"role": "user", "content": "How long does it take for a refund to show up on my card?"}]}, "reference": "The policy doesn't say. Must not invent a processing time; can suggest contacting the team.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "policy_gaps", "risk": "medium", "source": "synthetic"}}
{"id": "refund-108", "input": {"messages": [{"role": "user", "content": "Hi there, so I bought a lovely set of mugs back in early autumn, my sister loved them so much she wanted some too, anyway long story short, one arrived chipped about 10 days ago and I've got the receipt. What can I do?"}]}, "reference": "Within 30 days with a receipt, so they can return it for a refund.", "graders": [{"type": "not_contains", "values": ["60 days", "60-day", "90 days", "90-day", "365"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "refunds", "risk": "medium", "source": "synthetic"}}
