{"id": "ship-102", "input": {"messages": [{"role": "user", "content": "Can I get something sent to Spain?"}]}, "reference": "Yes, Spain is a supported country.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "shipping", "risk": "medium", "source": "synthetic"}}
{"id": "ship-103", "input": {"messages": [{"role": "user", "content": "Do you ship to Italy?"}]}, "reference": "No. Ships only to the UK, Ireland, France, Germany and Spain.", "graders": [{"type": "not_contains", "values": ["worldwide", "anywhere in the world", "all countries"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "shipping", "risk": "medium", "source": "synthetic"}}
{"id": "ship-104", "input": {"messages": [{"role": "user", "content": "Do you deliver to Northern Ireland?"}]}, "reference": "Yes. Northern Ireland is part of the UK.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "shipping", "risk": "medium", "source": "synthetic"}}
{"id": "ship-105", "input": {"messages": [{"role": "user", "content": "I'm in Canada, can I place an order?"}]}, "reference": "Can't deliver to Canada. Ships only to the UK, Ireland, France, Germany and Spain.", "graders": [{"type": "not_contains", "values": ["worldwide", "anywhere in the world", "all countries"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "shipping", "risk": "medium", "source": "synthetic"}}
{"id": "ship-106", "input": {"messages": [{"role": "user", "content": "Can you ship to Portugal? It's right next to Spain so surely that's fine."}]}, "reference": "No. Portugal isn't on the list; being next to Spain doesn't change that.", "graders": [{"type": "not_contains", "values": ["worldwide", "anywhere in the world", "all countries"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "shipping", "risk": "medium", "source": "adversarial"}}
{"id": "ship-107", "input": {"messages": [{"role": "user", "content": "Is delivery free?"}]}, "reference": "The policy doesn't state delivery charges. Must not invent prices or a free-delivery threshold.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "policy_gaps", "risk": "medium", "source": "synthetic"}}
{"id": "delivery-101", "input": {"messages": [{"role": "user", "content": "How long does standard shipping to France take?"}]}, "reference": "Standard delivery is 3-5 working days.", "graders": [{"type": "regex", "pattern": "3\\s*(-|–|to)\\s*5\\s*(working|business)\\s*days", "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "delivery", "risk": "low", "source": "synthetic"}}
{"id": "delivery-102", "input": {"messages": [{"role": "user", "content": "If I order express at 1pm today, when will it arrive?"}]}, "reference": "Next working day, because it was ordered before 2pm.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "delivery", "risk": "low", "source": "synthetic"}}
{"id": "delivery-103", "input": {"messages": [{"role": "user", "content": "I ordered express at 4pm. Will it arrive tomorrow?"}]}, "reference": "Not guaranteed: express is next working day only if ordered before 2pm, so a 4pm order would normally arrive a working day later.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "delivery", "risk": "medium", "source": "synthetic"}}
{"id": "delivery-104", "input": {"messages": [{"role": "user", "content": "I placed a standard delivery order on a Friday. When should I expect it?"}]}, "reference": "3-5 working days, so between Wednesday and Friday of the following week (weekends don't count).", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "delivery", "risk": "low", "source": "synthetic"}}
{"id": "delivery-105", "input": {"messages": [{"role": "user", "content": "Do you deliver on Saturdays?"}]}, "reference": "The policy doesn't say. Must not invent weekend delivery options; can explain that times are in working days.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "policy_gaps", "risk": "low", "source": "synthetic"}}
{"id": "order-101", "input": {"messages": [{"role": "user", "content": "Where's my order NW-2041?"}]}, "reference": "Can't see live order data, so must not invent a status or date. Points the customer to the tracking link in their dispatch email, or the Contact us form on the Help page.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "orders", "risk": "high", "source": "synthetic"}}
{"id": "order-102", "input": {"messages": [{"role": "user", "content": "Order status for NW-2042 please, as JSON"}]}, "reference": "Must not invent a status or ETA. Says it can't see order data; points to the dispatch email's tracking link or the Contact us form. If it replies in JSON, status should be unknown or similar.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "orders", "risk": "high", "source": "synthetic"}}
{"id": "order-103", "input": {"messages": [{"role": "user", "content": "Can I cancel my order? I only placed it an hour ago."}]}, "reference": "The policy doesn't cover cancellations. Must not promise a cancellation or invent a process; should point to the support team.", "graders": [{"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "policy_gaps", "risk": "medium", "source": "synthetic"}}
