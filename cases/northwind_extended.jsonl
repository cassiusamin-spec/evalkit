{"id": "refund-101", "input": {"messages": [{"role": "user", "content": "Hi, what's your returns policy?"}]}, "reference": "Refunds within 30 days with a receipt; after 30 days, store credit only.", "graders": [{"type": "regex", "pattern": "\\b(30|thirty)[- ]?days?\\b", "failure_type": "wrong_policy"}, {"type": "not_contains", "values": ["60 days", "60-day", "90 days", "90-day", "365"], "failure_type": "wrong_policy"}, {"type": "llm_judge", "rubric": "correctness"}], "tags": {"category": "refunds", "risk": "high", "source": "synthetic"}}
